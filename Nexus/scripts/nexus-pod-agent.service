# NEXUS pod agent — systemd unit
# ───────────────────────────────────────────────────────────────────────────
# Install: copy to /etc/systemd/system/nexus-pod-agent.service, then:
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now nexus-pod-agent
#
# Edit POD_ID and the paths below to match this pod. See
# docs/CONTROL_PLANE.md (Bootstrapping a pod) and docs/POD_MIGRATION.md
# (if you're moving over from the Oracle-era unit) for the full procedure
# including custom-claim minting.

[Unit]
Description=Nexus pod agent (Firestore inventory + heartbeat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# CHANGE: match the user that owns /opt/nexus.
User=nexus
Group=nexus
# CHANGE: cluster.yaml host id this pod corresponds to.
Environment=POD_ID=local
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/nexus
ExecStart=/usr/bin/python3 /opt/nexus/scripts/pod_agent.py \
          --pod-id ${POD_ID} \
          --service-account /etc/nexus/pod_agent.json \
          --cluster /opt/nexus/configs/cluster.yaml \
          --heartbeat-interval 15
Restart=always
RestartSec=10
# Don't leak a half-marked-online doc if the unit is stopped — the agent's
# SIGTERM handler writes status='offline' before exiting.
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
