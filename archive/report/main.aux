\BKM@entry{id=16,dest={73756273656374696F6E2E342E32},srcline={232}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Data flowing through the seasonal phenology submission, stage by stage. \textit  {Multi-scale tiling:} the input quadrat is partitioned into a $4{\times }4$ grid at the native scale (solid lines) and re-partitioned at scale $0.8$ (dashed inner rectangle), giving two tile sets. \textit  {ExG filter:} each tile's Excess Green index $\mathrm  {ExG}_t = 2G_t - R_t - B_t$ is computed and tiles with fewer than $15\%$ green pixels are dropped (greyed out with a cross). \textit  {Entropy weights:} the surviving tiles are weighted by $w_t \propto \exp (-H_t)\cdot \mathrm  {ExG}_t$, where bar height encodes the weight; confident, vegetation-rich tiles dominate the softmax-weighted mean. \textit  {Phenology curve:} the per-species observability density $P(s\mid d)$, smoothed from the GBIF month-of-observation histogram, is multiplied into the posterior in log space at $\beta {=}1.0$, where the dashed red line marks the quadrat's observation date $d$. \textit  {Species selection:} after class-prior logit adjustment, species whose probability exceeds $T{=}0.03$ are emitted; the bottom bar (greyed) falls below threshold and is rejected.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:phenology_illustration}{{6}{9}{Data flowing through the seasonal phenology submission, stage by stage. \textit {Multi-scale tiling:} the input quadrat is partitioned into a $4{\times }4$ grid at the native scale (solid lines) and re-partitioned at scale $0.8$ (dashed inner rectangle), giving two tile sets. \textit {ExG filter:} each tile's Excess Green index $\mathrm {ExG}_t = 2G_t - R_t - B_t$ is computed and tiles with fewer than $15\%$ green pixels are dropped (greyed out with a cross). \textit {Entropy weights:} the surviving tiles are weighted by $w_t \propto \exp (-H_t)\cdot \mathrm {ExG}_t$, where bar height encodes the weight; confident, vegetation-rich tiles dominate the softmax-weighted mean. \textit {Phenology curve:} the per-species observability density $P(s\mid d)$, smoothed from the GBIF month-of-observation histogram, is multiplied into the posterior in log space at $\beta {=}1.0$, where the dashed red line marks the quadrat's observation date $d$. \textit {Species selection:} after class-prior logit adjustment, species whose probability exceeds $T{=}0.03$ are emitted; the bottom bar (greyed) falls below threshold and is rejected}{figure.6}{}}
