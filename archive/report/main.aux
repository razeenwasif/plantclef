\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Inference pipeline for the headline anchor submission (solid path; public Macro F1 $0.418265$). Each quadrat is partitioned into a $4{\times }4$ grid of $448$-pixel non-overlapping tiles and forwarded through the partially fine-tuned BioCLIP~2.5 ViT-H/14 (lower 28 transformer blocks frozen; last 4 plus LN and projection unfrozen) at two inference resolutions, $224$ and $336$ pixels. Per-tile softmax probabilities are averaged across the 16 tiles and across the two resolutions, then class-prior logit adjustment ($\tau {=}0.25$) is applied before an adaptive sigmoid threshold ($T{=}0.03$, $k_{\min }{=}2$, $k_{\max }{=}10$) selects the output species set. Three architecture-orthogonal pivots (dashed; cRT triple-backbone classifier retraining, genus co-occurrence rerank, seasonal phenology prior) indicate where alternative configurations insert into the anchor; all three scored below the anchor on the leaderboard and are reported in Section~\ref {sec:experiments}.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:pipeline}{{3}{5}{Inference pipeline for the headline anchor submission (solid path; public Macro F1 $0.418265$). Each quadrat is partitioned into a $4{\times }4$ grid of $448$-pixel non-overlapping tiles and forwarded through the partially fine-tuned BioCLIP~2.5 ViT-H/14 (lower 28 transformer blocks frozen; last 4 plus LN and projection unfrozen) at two inference resolutions, $224$ and $336$ pixels. Per-tile softmax probabilities are averaged across the 16 tiles and across the two resolutions, then class-prior logit adjustment ($\tau {=}0.25$) is applied before an adaptive sigmoid threshold ($T{=}0.03$, $k_{\min }{=}2$, $k_{\max }{=}10$) selects the output species set. Three architecture-orthogonal pivots (dashed; cRT triple-backbone classifier retraining, genus co-occurrence rerank, seasonal phenology prior) indicate where alternative configurations insert into the anchor; all three scored below the anchor on the leaderboard and are reported in Section~\ref {sec:experiments}}{figure.3}{}}
\BKM@entry{id=11,dest={73756273656374696F6E2E332E34},srcline={185}}{}
