\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Unfrozen-blocks ablation on the 010 recipe. Performance peaks sharply at four blocks; one block too few costs $0.009$ Macro F1, one block too many costs $0.014$. Full fine-tuning collapses the Tree-of-Life prior and is catastrophic.}}{10}{table.1}\protected@file@percent }
\newlabel{tab:blocks}{{1}{10}{Unfrozen-blocks ablation on the 010 recipe. Performance peaks sharply at four blocks; one block too few costs $0.009$ Macro F1, one block too many costs $0.014$. Full fine-tuning collapses the Tree-of-Life prior and is catastrophic}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Unfrozen-blocks sweep visualised with both metrics. Held-out validation top-5 (dashed, right axis) rises monotonically with capacity from $n{=}0$ to $n{=}5$, but Kaggle Macro F1 (solid, left axis) peaks sharply at $n{=}4$ and collapses at full fine-tune ($n{=}32$). The disagreement between the two curves is the load-bearing finding of \S  \ref {sec:discussion}: validation accuracy on the single-plant distribution does not predict multi-species quadrat Macro F1.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:unfreeze_sweep}{{7}{10}{Unfrozen-blocks sweep visualised with both metrics. Held-out validation top-5 (dashed, right axis) rises monotonically with capacity from $n{=}0$ to $n{=}5$, but Kaggle Macro F1 (solid, left axis) peaks sharply at $n{=}4$ and collapses at full fine-tune ($n{=}32$). The disagreement between the two curves is the load-bearing finding of \S \ref {sec:discussion}: validation accuracy on the single-plant distribution does not predict multi-species quadrat Macro F1}{figure.7}{}}
