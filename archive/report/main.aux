\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Joint $\tau \times T$ sweep on the i002 last-four-blocks checkpoint, single-resolution 224-pixel inference. Public Macro F1. The peak at $(\tau {=}0.25, T{=}0.03)$ is the anchor value taken into the 224+336 ensemble that produces the headline $0.418265$ in Table~\ref {tab:summary}.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:tau_T}{{3}{13}{Joint $\tau \times T$ sweep on the i002 last-four-blocks checkpoint, single-resolution 224-pixel inference. Public Macro F1. The peak at $(\tau {=}0.25, T{=}0.03)$ is the anchor value taken into the 224+336 ensemble that produces the headline $0.418265$ in Table~\ref {tab:summary}}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Selection-rule ablation at $\tau {=}0.25$ on the i002 last-four-blocks single-resolution checkpoint. Probability-thresholding at $T{=}0.03$ dominates; fixed top-$k$ is competitive at $k{=}2$ because the test-set mean cardinality is empirically $\sim $2--3 species per quadrat. Both gap and relative-threshold variants underperform the anchor by between $0.06$ and $0.10$ Macro F1.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:select_rule}{{4}{13}{Selection-rule ablation at $\tau {=}0.25$ on the i002 last-four-blocks single-resolution checkpoint. Probability-thresholding at $T{=}0.03$ dominates; fixed top-$k$ is competitive at $k{=}2$ because the test-set mean cardinality is empirically $\sim $2--3 species per quadrat. Both gap and relative-threshold variants underperform the anchor by between $0.06$ and $0.10$ Macro F1}{table.4}{}}
